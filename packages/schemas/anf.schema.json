{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Annotix Native Format (ANF) Schema",
  "type": "object",
  "required": ["image", "width", "height", "objects"],
  "properties": {
    "image": { "type": "string" },
    "width": { "type": "integer" },
    "height": { "type": "integer" },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label_id", "bbox", "confidence", "source", "verified"],
        "properties": {
          "id": { "type": "string" },
          "label_id": { "type": "string" },
          "bbox": {
            "type": "array",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "polygon": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "mask": { "type": ["string", "null"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "source": { "type": "string" },
          "verified": { "type": "boolean" },
          "attributes": { "type": "object" }
        }
      }
    }
  }
}
