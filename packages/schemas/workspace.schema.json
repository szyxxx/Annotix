{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Annotix Workspace Schema",
  "type": "object",
  "required": ["schema_version", "id", "name", "projects", "settings"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "id": { "type": "string" },
    "name": { "type": "string" },
    "created_at": { "type": "integer" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "path"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "last_opened": { "type": "integer" }
        }
      }
    },
    "settings": { "type": "object" }
  }
}
